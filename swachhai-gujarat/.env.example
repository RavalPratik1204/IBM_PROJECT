# ─────────────────────────────────────────────
# SwachhAI Gujarat — Environment Configuration
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────

# ── App ──────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-this-to-a-random-64-char-string
DEBUG=true
DEMO_MODE=true

# ── Database ─────────────────────────────────
DATABASE_URL=sqlite:///./swachhai.db
# For production PostgreSQL:
# DATABASE_URL=postgresql://user:password@host:5432/swachhai

# ── JWT ──────────────────────────────────────
JWT_SECRET=change-this-to-another-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── AI Provider ──────────────────────────────
PRIMARY_LLM_PROVIDER=groq
FALLBACK_LLM_PROVIDER=groq

# ── IBM watsonx.ai ───────────────────────────
# Required for Phase 10 (IBM Granite integration)
IBM_API_KEY=
IBM_PROJECT_ID=
IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com
IBM_GRANITE_MODEL=ibm/granite-3-8b-instruct

# ── Groq ─────────────────────────────────────
# Required for Phase 11
GROQ_API_KEY=
GROQ_PRIMARY_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant

# ── CORS ─────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
